{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "contracts:check": "cargo run --manifest-path ../Cargo.toml --locked --package rust-be-template --bin openapi-contracts -- check",
    "contracts:generate": "cargo run --manifest-path ../Cargo.toml --locked --package rust-be-template --bin openapi-contracts -- generate",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "optimization:check": "tsc --noEmit --project tsconfig.optimization.json && eslint e2e/optimization playwright.optimization.config.ts vitest.optimization.config.ts --max-warnings 0 && vitest run --config vitest.optimization.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:security": "playwright test --config=playwright.security.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.55",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "^24.19.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@solid-primitives/keyed": "3.0.0-next.4",
    "@solid-primitives/utils": "7.0.0-next.7",
    "@solidjs/router": "2.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.20",
    "@toast-ui/editor": "^3.2.2",
    "chart.js": "^4.6.1",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "leaflet": "1.9.4",
    "leaflet-geosearch": "^5.2.0",
    "marked": "^18.1.3",
    "solid-js": "2.0.0-rc.20",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.7"
    },
    "minimatch": "^11.0.4"
  }
}
