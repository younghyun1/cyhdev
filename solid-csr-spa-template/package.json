{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "contracts:check": "cargo run --manifest-path ../Cargo.toml --locked --package rust-be-template --bin openapi-contracts -- check",
    "contracts:generate": "cargo run --manifest-path ../Cargo.toml --locked --package rust-be-template --bin openapi-contracts -- generate",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "1.0.0-beta.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/leaflet": "^1.9.22",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-solid": "^0.16.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@solid-primitives/keyed": "3.0.0-next.2",
    "@solid-primitives/utils": "7.0.0-next.4",
    "@solidjs/router": "2.0.0-next.17",
    "@solidjs/web": "2.0.0-rc.1",
    "@toast-ui/editor": "^3.2.2",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "marked": "^18.0.11",
    "solid-js": "2.0.0-rc.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
