# Copy to .env and fill in real values. Deployments load this file via the
# OpenRC service's `source` line, so keep variable names in sync with
# src/init/state and src/domain/live_chat/rtc/config.rs.

# Application and AWS environment
IS_AWS_ECS=false
APP_NAME_VERSION=rust-be-template-0.1.0

# Database configuration
DB_URL=postgres://user:password@/be_db?host=localhost
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME="user"
DB_PASSWORD="password"
DB_NAME=be_db
# Optional pooled connection limit (1-256, default 24). Pooled sessions also get
# statement_timeout=30s, lock_timeout=5s, and idle_in_transaction_session_timeout=60s;
# do not set `options` in DB_URL. Migrations use a separate unbounded connection.
# DB_POOL_MAX_SIZE=24

# AWS SES SMTP credentials
AWS_SES_SMTP_URL=email-smtp.ap-northeast-2.amazonaws.com
AWS_SES_SMTP_USERNAME=changeme
AWS_SES_SMTP_ACCESS_KEY=changeme

# AWS image upload keys
AWS_IMAGE_UPLOAD_KEY=changeme
AWS_IMAGE_UPLOAD_SECRET_KEY=changeme

# Environment and server configuration
CURR_ENV=local
HOST_IP=0.0.0.0
HOST_PORT=443

# Optional: absolute path to squaremap's public web directory only.
# Without this setting, /minecraft/map/ returns a setup placeholder.
# SQUAREMAP_WEB_DIR=/home/cyh/mcserver/plugins/squaremap/web
# Optional superuser Minecraft controls. Connects only to 127.0.0.1; both values are required.
# MINECRAFT_MANAGEMENT_PORT=25576
# MINECRAFT_MANAGEMENT_SECRET=<40 alphanumeric characters matching server.properties>
# Optional CyhdevMapControl plugin socket; private to the Minecraft/website OS user.
# MINECRAFT_MAP_CONTROL_SOCKET=/home/cyh/mcserver/plugins/CyhdevMapControl/control.sock

# Canonical browser origin used for CORS, OIDC callbacks, and account email
# links. Development and staging must set an explicit HTTPS origin.
PUBLIC_APP_ORIGIN=https://localhost:30737

# TLS certificates
CERT_CHAIN_DIR="./certs/fullchain.pem"
PRIV_KEY_DIR="./certs/privkey.pem"

# Optional additional exact origins for credentialed CORS and state changes.
# The canonical PUBLIC_APP_ORIGIN is always trusted automatically.
# Local HTTP entries are accepted only for localhost or loopback IP addresses.
TRUSTED_BROWSER_ORIGINS=https://localhost:30737

# Optional generic OpenID Connect provider. Leave all OIDC_* values absent to
# disable the API and hide its UI. The provider registration callback must be
# exactly ${PUBLIC_APP_ORIGIN}/api/auth/oidc/callback. OIDC_CLIENT_SECRET is
# optional for public clients and remains server-side when supplied.
# OIDC_PROVIDER_NAME=Example Identity
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=replace-with-provider-client-id
# OIDC_CLIENT_SECRET=replace-with-server-side-client-secret

# WebRTC SFU (group audio/video calls). Disabled by default. When enabled,
# RTC_PUBLIC_IP and RTC_UDP_PORT_START are required; otherwise the SFU stays off.
# The SFU binds one UDP port per participant: RTC_UDP_PORT_START through
# RTC_UDP_PORT_START + RTC_MAX_PARTICIPANTS - 1. Open/forward that whole range.
RTC_ENABLE=false
RTC_PUBLIC_IP=127.0.0.1
RTC_UDP_PORT_START=3478
RTC_MAX_PARTICIPANTS=16
# Optional TURN relay fallback for symmetric-NAT clients (usually unneeded with a public IP):
# RTC_TURN_URL=turn:turn.example.com:3478
# RTC_TURN_USER=user
# RTC_TURN_PASS=pass
