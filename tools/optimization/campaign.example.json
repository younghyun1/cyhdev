    "admin": {"login": {"kind": "request", "method": "POST", "route": "/api/auth/login", "path": "/api/auth/login", "status": 200, "body": {"user_email": "fixture-admin@example.test", "user_password": "${CYHDEV_OPT_ADMIN_PASSWORD}"}, "json_pointer": "/success", "equals": true}}
  },
  "pages": {},
